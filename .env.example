# Docker Compose environment — copy to .env and adjust
# Generate a strong secret, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=24h

# Public port the site is served on
HTTP_PORT=8080

# Allowed origin(s) for the API (comma-separated). Use your domain in production.
CORS_ORIGIN=*
