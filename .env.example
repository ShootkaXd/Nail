# Docker Compose environment — copy to .env and adjust
# Generate a strong secret, e.g.:  openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRES_IN=24h

# Public port the site is served on (direct, no HTTPS — used without the
# "https" Caddy profile; safe to leave as-is even in production, since
# Caddy will be the only externally reachable port there)
HTTP_PORT=8080

# Allowed origin(s) for the API (comma-separated). Use your real domain in
# production, e.g. CORS_ORIGIN=https://salon.example.com
CORS_ORIGIN=*

# Only needed for production HTTPS via the "https" Caddy profile.
# Must be a domain name with a DNS A record pointing at this server's IP.
# DOMAIN=salon.example.com
