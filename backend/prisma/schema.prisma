datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           Int           @id @default(autoincrement())
  name         String
  login        String        @unique
  email        String?
  phone        String?
  passwordHash String
  role         String        @default("master")
  twoFactorSecret  String?
  twoFactorEnabled Boolean       @default(false)
  masterProfile MasterProfile?
  appointments  Appointment[] @relation("MasterAppointments")
  workingHours  WorkingHour[]
  createdAt    DateTime      @default(now())
}

model Service {
  id              Int                  @id @default(autoincrement())
  name            String
  description     String?
  category        String
  durationMinutes Int
  price           Float
  isActive        Boolean              @default(true)
  masterServices  MasterService[]
  appointments    AppointmentService[]
  promotions      Promotion[]
}

model MasterProfile {
  id             Int             @id @default(autoincrement())
  userId         Int             @unique
  bio            String?
  address        String?
  avatarUrl      String?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  masterServices MasterService[]
  photos         MasterPhoto[]
}

model MasterPhoto {
  id        Int           @id @default(autoincrement())
  masterId  Int
  url       String
  caption   String?
  createdAt DateTime      @default(now())
  master    MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)
}

model MasterService {
  masterId    Int
  serviceId   Int
  customPrice Float?
  master      MasterProfile @relation(fields: [masterId], references: [id], onDelete: Cascade)
  service     Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([masterId, serviceId])
}

model Promotion {
  id              Int      @id @default(autoincrement())
  name            String
  serviceId       Int?
  discountPercent Int
  startDate       DateTime
  endDate         DateTime
  isActive        Boolean  @default(true)
  service         Service? @relation(fields: [serviceId], references: [id])
}

model WorkingHour {
  id        Int     @id @default(autoincrement())
  masterId  Int
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean @default(true)
  master    User    @relation(fields: [masterId], references: [id], onDelete: Cascade)
}

model Appointment {
  id                Int                  @id @default(autoincrement())
  clientName        String
  clientPhone       String
  clientPhoneDigits String               @default("") // normalized last-10-digits, for "my bookings" lookup
  clientEmail       String?
  masterId          Int
  startAt           DateTime
  endAt             DateTime
  status            String               @default("pending")
  notes             String?
  totalPrice        Float
  createdAt         DateTime             @default(now())
  master            User                 @relation("MasterAppointments", fields: [masterId], references: [id])
  services          AppointmentService[]

  @@index([clientPhoneDigits])
}

// One row per service booked within an appointment — a booking can now
// combine multiple services (with a master who offers all of them) back
// to back in a single slot. `price` freezes what that service cost at
// booking time (after any per-master custom price / promotion discount),
// same way `Appointment.totalPrice` already did for the single-service case.
model AppointmentService {
  id            Int         @id @default(autoincrement())
  appointmentId Int
  serviceId     Int
  price         Float
  appointment   Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  service       Service     @relation(fields: [serviceId], references: [id])

  @@index([appointmentId])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @default(now())
}
